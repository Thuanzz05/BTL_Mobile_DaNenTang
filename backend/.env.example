# Environment
NODE_ENV=development

# Server
PORT=5000
API_PREFIX=/api

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=hoc_tu_vung

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345678
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-98765432
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:5173,http://127.0.0.1:5173

# Upload
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Password reset email (Optional in development)
RESEND_API_KEY=
PASSWORD_RESET_FROM=Wordleaf <no-reply@example.com>
# Chỉ bật trên máy phát triển tin cậy để ứng dụng tự điền mã khi chưa cấu hình email
PASSWORD_RESET_EXPOSE_CODE=false
