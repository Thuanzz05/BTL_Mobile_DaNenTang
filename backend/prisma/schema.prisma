generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum PhuongThucDangNhap {
  local
  google
}

enum VaiTro {
  user
  admin
}

enum TrangThaiNguoiDung {
  active
  inactive
  locked
}

enum TrangThaiChuDe {
  active
  inactive
}

enum LoaiTu {
  danh_tu  @map("danh-tu")
  dong_tu  @map("dong-tu")
  tinh_tu  @map("tinh-tu")
  trang_tu @map("trang-tu")
  gioi_tu  @map("gioi-tu")
  lien_tu  @map("lien-tu")
  dai_tu   @map("dai-tu")
  tham_tu  @map("tham-tu")
}

enum TrangThaiPhienHoc {
  dang_hoc   @map("dang-hoc")
  hoan_thanh @map("hoan-thanh")
  bo_do      @map("bo-do")
}

enum TrangThaiKetQua {
  da_nho    @map("da-nho")
  chua_chac @map("chua-chac")
  chua_nho  @map("chua-nho")
}

enum TrangThaiNho {
  chua_hoc   @map("chua-hoc")
  chua_nho   @map("chua-nho")
  chua_chac  @map("chua-chac")
  da_nho     @map("da-nho")
  thuoc_long @map("thuoc-long")
}

// ==========================================
// 1. NGƯỜI DÙNG & XÁC THỰC
// ==========================================

model NguoiDung {
  id                 String               @id @default(uuid()) @db.Char(36)
  hoTen              String               @map("ho_ten") @db.VarChar(150)
  email              String               @unique @db.VarChar(150)
  matKhauHash        String?              @map("mat_khau_hash") @db.VarChar(255)
  phuongThucDangNhap PhuongThucDangNhap   @default(local) @map("phuong_thuc_dang_nhap")
  providerId         String?              @map("provider_id") @db.VarChar(255)
  anhDaiDien         String?              @map("anh_dai_dien") @db.VarChar(255)
  vaiTro             VaiTro               @default(user) @map("vai_tro")
  trangThai          TrangThaiNguoiDung   @default(active) @map("trang_thai")
  ngayTao            DateTime             @default(now()) @map("ngay_tao")
  ngayCapNhat        DateTime             @updatedAt @map("ngay_cap_nhat")

  tokenLamMoi        TokenLamMoi[]
  yeuThich           YeuThich[]
  phienHocTap        PhienHocTap[]
  tienDoTuVung       TienDoTuVung[]
  hoatDongHocTap     HoatDongHocTap[]
  thanhTichNguoiDung ThanhTichNguoiDung[]

  @@index([trangThai])
  @@map("nguoi_dung")
}

model TokenLamMoi {
  id              String   @id @default(uuid()) @db.Char(36)
  nguoiDungId     String   @map("nguoi_dung_id") @db.Char(36)
  token           String   @unique @db.VarChar(512)
  thoiGianHetHan  DateTime @map("thoi_gian_het_han")
  daThuHoi        Boolean  @default(false) @map("da_thu_hoi")
  thongTinThietBi String?  @map("thong_tin_thiet_bi") @db.VarChar(255)
  ngayTao         DateTime @default(now()) @map("ngay_tao")

  nguoiDung NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)

  @@index([nguoiDungId])
  @@map("token_lam_moi")
}

// ==========================================
// 2. CHỦ ĐỀ TỪ VỰNG
// ==========================================

model ChuDe {
  id           String         @id @default(uuid()) @db.Char(36)
  ten          String         @db.VarChar(255)
  moTa         String?        @map("mo_ta") @db.Text
  hinhAnh      String?        @map("hinh_anh") @db.VarChar(500)
  trangThai    TrangThaiChuDe @default(active) @map("trang_thai")
  thuTuHienThi Int            @default(0) @map("thu_tu_hien_thi")
  ngayTao      DateTime       @default(now()) @map("ngay_tao")
  ngayCapNhat  DateTime       @updatedAt @map("ngay_cap_nhat")

  tuVung      TuVung[]
  phienHocTap PhienHocTap[]

  @@index([trangThai])
  @@index([thuTuHienThi])
  @@map("chu_de")
}

// ==========================================
// 3. TỪ VỰNG
// ==========================================

model TuVung {
  id             String   @id @default(uuid()) @db.Char(36)
  chuDeId        String   @map("chu_de_id") @db.Char(36)
  tuTiengAnh     String   @map("tu_tieng_anh") @db.VarChar(120)
  phienAm        String?  @map("phien_am") @db.VarChar(120)
  loaiTu         LoaiTu   @map("loai_tu")
  nghiaTiengViet String   @map("nghia_tieng_viet") @db.VarChar(255)
  urlAmThanh     String?  @map("url_am_thanh") @db.VarChar(500)
  urlHinhAnh     String?  @map("url_hinh_anh") @db.VarChar(500)
  thuTuHienThi   Int      @default(0) @map("thu_tu_hien_thi")
  ngayTao        DateTime @default(now()) @map("ngay_tao")
  ngayCapNhat    DateTime @updatedAt @map("ngay_cap_nhat")

  chuDe        ChuDe          @relation(fields: [chuDeId], references: [id], onDelete: Cascade)
  viDu         ViDu[]
  yeuThich     YeuThich[]
  ketQuaHoc    KetQuaHoc[]
  tienDoTuVung TienDoTuVung[]

  @@index([chuDeId])
  @@index([tuTiengAnh])
  @@index([thuTuHienThi])
  @@map("tu_vung")
}

model ViDu {
  id           String   @id @default(uuid()) @db.Char(36)
  tuVungId     String   @map("tu_vung_id") @db.Char(36)
  cauTiengAnh  String   @map("cau_tieng_anh") @db.Text
  cauTiengViet String   @map("cau_tieng_viet") @db.Text
  thuTuHienThi Int      @default(0) @map("thu_tu_hien_thi")
  ngayTao      DateTime @default(now()) @map("ngay_tao")

  tuVung TuVung @relation(fields: [tuVungId], references: [id], onDelete: Cascade)

  @@index([tuVungId])
  @@map("vi_du")
}

// ==========================================
// 4. YÊU THÍCH
// ==========================================

model YeuThich {
  id          String   @id @default(uuid()) @db.Char(36)
  nguoiDungId String   @map("nguoi_dung_id") @db.Char(36)
  tuVungId    String   @map("tu_vung_id") @db.Char(36)
  ngayTao     DateTime @default(now()) @map("ngay_tao")

  nguoiDung NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)
  tuVung    TuVung    @relation(fields: [tuVungId], references: [id], onDelete: Cascade)

  @@unique([nguoiDungId, tuVungId])
  @@index([nguoiDungId])
  @@index([tuVungId])
  @@map("yeu_thich")
}

// ==========================================
// 5. PHIÊN HỌC TẬP
// ==========================================

model PhienHocTap {
  id          String             @id @default(uuid()) @db.Char(36)
  nguoiDungId String             @map("nguoi_dung_id") @db.Char(36)
  chuDeId     String             @map("chu_de_id") @db.Char(36)
  tongSoTu    Int                @map("tong_so_tu")
  batDauLuc   DateTime           @default(now()) @map("bat_dau_luc")
  ketThucLuc  DateTime?          @map("ket_thuc_luc")
  trangThai   TrangThaiPhienHoc  @default(dang_hoc) @map("trang_thai")

  nguoiDung NguoiDung   @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)
  chuDe     ChuDe       @relation(fields: [chuDeId], references: [id], onDelete: Cascade)
  ketQuaHoc KetQuaHoc[]

  @@index([nguoiDungId])
  @@index([chuDeId])
  @@index([batDauLuc])
  @@index([trangThai])
  @@map("phien_hoc_tap")
}

model KetQuaHoc {
  id            String          @id @default(uuid()) @db.Char(36)
  phienHocTapId String          @map("phien_hoc_tap_id") @db.Char(36)
  tuVungId      String          @map("tu_vung_id") @db.Char(36)
  trangThai     TrangThaiKetQua @map("trang_thai")
  ngayTao       DateTime        @default(now()) @map("ngay_tao")

  phienHocTap PhienHocTap @relation(fields: [phienHocTapId], references: [id], onDelete: Cascade)
  tuVung      TuVung      @relation(fields: [tuVungId], references: [id], onDelete: Cascade)

  @@index([phienHocTapId])
  @@index([tuVungId])
  @@map("ket_qua_hoc")
}

// ==========================================
// 6. TIẾN ĐỘ HỌC TẬP & SPACED REPETITION
// ==========================================

model TienDoTuVung {
  nguoiDungId       String       @map("nguoi_dung_id") @db.Char(36)
  tuVungId          String       @map("tu_vung_id") @db.Char(36)
  daHoc             Boolean      @default(false) @map("da_hoc")
  yeuThich          Boolean      @default(false) @map("yeu_thich")
  soLanOnTap        Int          @default(0) @map("so_lan_on_tap")
  trangThaiNho      TrangThaiNho @default(chua_hoc) @map("trang_thai_nho")
  ngayOnTapTiepTheo DateTime?    @map("ngay_on_tap_tiep_theo")
  lanOnTapCuoi      DateTime?    @map("lan_on_tap_cuoi")
  ngayTao           DateTime     @default(now()) @map("ngay_tao")
  ngayCapNhat       DateTime     @updatedAt @map("ngay_cap_nhat")

  nguoiDung NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)
  tuVung    TuVung    @relation(fields: [tuVungId], references: [id], onDelete: Cascade)

  @@id([nguoiDungId, tuVungId])
  @@index([nguoiDungId])
  @@index([nguoiDungId, yeuThich])
  @@index([nguoiDungId, daHoc])
  @@index([nguoiDungId, ngayOnTapTiepTheo])
  @@map("tien_do_tu_vung")
}

// ==========================================
// 7. HOẠT ĐỘNG HỌC TẬP
// ==========================================

model HoatDongHocTap {
  id             String   @id @default(uuid()) @db.Char(36)
  nguoiDungId    String   @map("nguoi_dung_id") @db.Char(36)
  loaiHoatDong   String   @map("loai_hoat_dong") @db.VarChar(100)
  moTa           String   @map("mo_ta") @db.Text
  diemKinhNghiem Int      @default(0) @map("diem_kinh_nghiem")
  ngayTao        DateTime @default(now()) @map("ngay_tao")

  nguoiDung NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)

  @@index([nguoiDungId])
  @@index([ngayTao])
  @@map("hoat_dong_hoc_tap")
}

// ==========================================
// 8. THÀNH TÍCH
// ==========================================

model ThanhTich {
  id        String   @id @default(uuid()) @db.Char(36)
  tieuDe    String   @map("tieu_de") @db.VarChar(150)
  moTa      String   @map("mo_ta") @db.Text
  bieuTuong String   @map("bieu_tuong") @db.VarChar(100)
  diemThuong Int     @default(0) @map("diem_thuong")
  ngayTao   DateTime @default(now()) @map("ngay_tao")

  thanhTichNguoiDung ThanhTichNguoiDung[]

  @@map("thanh_tich")
}

model ThanhTichNguoiDung {
  nguoiDungId String   @map("nguoi_dung_id") @db.Char(36)
  thanhTichId String   @map("thanh_tich_id") @db.Char(36)
  ngayMoKhoa  DateTime @default(now()) @map("ngay_mo_khoa")

  nguoiDung NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)
  thanhTich ThanhTich @relation(fields: [thanhTichId], references: [id], onDelete: Cascade)

  @@id([nguoiDungId, thanhTichId])
  @@index([nguoiDungId])
  @@map("thanh_tich_nguoi_dung")
}
