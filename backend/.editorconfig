# EditorConfig for Visual Studio 2022
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# TypeScript/JavaScript
[*.{ts,js,json}]
indent_style = space
indent_size = 2
quote_type = single

# Markdown
[*.md]
trim_trailing_whitespace = false

# SQL
[*.sql]
indent_size = 2

# Environment files
[.env*]
insert_final_newline = false
